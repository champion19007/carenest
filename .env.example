# ---------------------------------------------------------------- site
# Used for canonical URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://carenest.in

# ----------------------------------------------------------------- SMS
# Leave SMS_PROVIDER unset in development: the OTP is then printed to the
# server console and shown on screen. Setting it switches to a real gateway,
# and the code stops being returned to the browser.
#
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=          # DLT-approved template, required in India
# MSG91_SENDER_ID=
#
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...

# ------------------------------------------------------------ databases
# Defaults to embedded SQLite + NeDB under ./.data (no setup needed).
# For a deployed environment, point these at managed services instead —
# see DEPLOYMENT.md for the swap.
#
# DATABASE_URL=postgres://user:pass@host:5432/carenest
# MONGODB_URI=mongodb+srv://user:pass@cluster/carenest
