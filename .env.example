# ---------------------------------------------------------------- site
# Used for canonical URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://carenest.in

# ----------------------------------------------------------------- SMS
# Leave SMS_PROVIDER unset in development: the OTP is then printed to the
# server console and shown on screen. Setting it switches to a real gateway,
# and the code stops being returned to the browser.
#
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=          # DLT-approved template, required in India
# MSG91_SENDER_ID=
#
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...

# ------------------------------------------------------------ database
# Unset, the app runs PGlite (Postgres compiled to WASM) under ./.data, so
# there is nothing to install. Set DATABASE_URL and it uses Neon instead —
# the same Postgres dialect either way, which is the point.
#
# The schema creates three namespaces in that one database: patient, provider
# and clinic. See lib/db/schema.ts for why they are schemas and not three
# separate databases.
#
# DATABASE_URL=postgres://user:pass@host/carenest?sslmode=require

# Signs the claims cookie that middleware verifies on the edge.
# Must be at least 32 characters; the app refuses to start in production without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# -------------------------------------------------------- Google sign-in
# Optional. With these unset the Google button simply does not appear and
# phone + OTP is the only way in — nothing breaks.
#
# To enable it, in the Google Cloud console:
#   1. APIs & Services -> Credentials -> Create OAuth client ID -> Web application
#   2. Authorised redirect URI: http://localhost:3000/api/auth/google/callback
#      (and https://<your-domain>/api/auth/google/callback for production)
#   3. Paste the client id and secret below.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The origin Google is told to redirect back to. Needed only when the app
# cannot work its own origin out — behind a proxy, or on a custom domain —
# because Google matches the redirect URI exactly.
# APP_URL=https://carenest.vercel.app

# Protects the scheduled slot sweep at /api/cron/sweep. Vercel sends this as a
# bearer token on cron invocations. With no value set the route refuses to run
# rather than defaulting to open.
CRON_SECRET=
