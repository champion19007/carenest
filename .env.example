# Copy to .env.local. Never commit real credentials.
# npm run dev/start forces loopback and embedded PostgreSQL; no cloud is used.
APP_ORIGIN=http://127.0.0.1:3000
SMS_PROVIDER=disabled
ALLOW_LOCAL_OTP=0
ENABLE_PAYMENTS=0
ENABLE_EXTERNAL_TRIAGE=0
ENABLE_SYMPTOM_ROUTING=0
TRUST_PROXY=0
# Independent local keys are generated in .data/secrets. Back them up with the DB.
# AUTH_SECRET= (minimum 32 characters; required for non-local operation)
# DATA_ENCRYPTION_KEY= (64 hex characters; required for non-local operation)
# Vercel needs its own private settings; this local file is never uploaded.
# DATABASE_URL=postgresql://user:password@your-host/your-database?sslmode=require
# On Vercel: CARENEST_LOCAL_MODE must be unset or 0. Run explicit remote migrations.
# npm run video:local generates private credentials and runs loopback-only LiveKit.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET= (minimum 32 characters; server only)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# CASHFREE_CLIENT_ID= (Payment Gateway sandbox App ID; server only)
# CASHFREE_CLIENT_SECRET= (Payment Gateway sandbox secret; server only)
# Set ENABLE_PAYMENTS=1 after saving credentials. MVP has no production mode.
# WhatsApp sandbox sends real messages only to the single joined Indian test number.
WHATSAPP_SANDBOX_ENABLED=0
# TWILIO_ACCOUNT_SID=AC... (Twilio account SID, server only)
# TWILIO_AUTH_TOKEN= (server only)
# WHATSAPP_FROM=whatsapp:+14155238886 (use the sender shown by your sandbox)
# WHATSAPP_TEST_TO=+91... (your joined test number)
# Use approved HX content templates, or a current 24-hour sandbox reply window.
# WHATSAPP_OTP_CONTENT_SID=HX... (variables 1=CareNest, 2=code)
# WHATSAPP_UPDATE_CONTENT_SID=HX... (variables 1=CareNest, 2=generic account update)
# WHATSAPP_SANDBOX_WINDOW_EXPIRES_AT= (ISO timestamp, maximum 24 hours from join/message)
# Optional HTTPS callback; manual delivery checks work without exposing localhost.
# WHATSAPP_STATUS_CALLBACK_URL=https://your-test-host/api/webhooks/whatsapp
# CLAMSCAN_PATH= (absolute executable path; PDFs remain quarantined without it)
# RESEND_API_KEY=
# EMAIL_FROM=
# Email delivery requires explicit activation, including local testing.
EMAIL_ENABLED=0
# EMAIL_PROVIDER=gmail (demo) or resend (verified sender domain)
EMAIL_LOCAL_DAILY_LIMIT=10
# GMAIL_SENDER_EMAIL=your_sender@gmail.com
# GMAIL_APP_PASSWORD= (16-character Google app password; never your account password)
# APP_URL=http://localhost:3000 (must match your registered Google OAuth callback)
# Zoom API and SDK have been retired. Google Meet remains optional.
# Optional named-key envelope rotation. Keep the original storage key for v2 records/backups.
# DATA_ENCRYPTION_ACTIVE_ID=
# DATA_ENCRYPTION_KEYRING= (JSON map of key IDs to 64-character hex keys)

# Separate Cashfree Payouts sandbox account; never reuse PG secrets
ENABLE_DOCTOR_PAYOUTS=0
# CASHFREE_PAYOUT_CLIENT_ID=
# CASHFREE_PAYOUT_CLIENT_SECRET=
# Optional Cashfree TEST public key alternative to IP whitelist; server reads it only
# CASHFREE_PAYOUT_PUBLIC_KEY_PATH=.data/cashfree-payout-public-key.pem

# Fast2SMS: approve templates once. OTPs target signup/login input automatically.
# A saved test phone is needed only for optional local update tests.
FAST2SMS_ENABLED=0
FAST2SMS_LOCAL_DAILY_LIMIT=10
# MESSAGING_PROVIDER=fast2sms
# SMS_PROVIDER=fast2sms
# ALLOW_LOCAL_OTP=0
# FAST2SMS_API_KEY=
# FAST2SMS_TEST_PHONE=your_10_digit_Indian_test_phone
# FAST2SMS_SMS_OTP_ID=
FAST2SMS_SMS_OTP_ROUTE=smart
# Explicit local-only demo alternative: FAST2SMS_SMS_OTP_ROUTE=quick
# Fast2SMS's linked guide lists Quick SMS at Rs 5 per SMS; no Smart OTP ID needed.
FAST2SMS_QUICK_OTP_DAILY_LIMIT=2
# FAST2SMS_SMS_SENDER_ID=
# FAST2SMS_SMS_UPDATE_MESSAGE_ID=
# FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
# FAST2SMS_WHATSAPP_OTP_TEMPLATE=carenest_login_otp
# FAST2SMS_WHATSAPP_UPDATE_TEMPLATE=carenest_transaction_update
# FAST2SMS_WHATSAPP_BOOKING_TEMPLATE=carenest_booking_confirmed
# FAST2SMS_WHATSAPP_REMINDER_TEMPLATE=carenest_appointment_reminder
# Booking/reminder body variables: doctor, date, time (IST), visit type, CareNest URL.
# FAST2SMS_WHATSAPP_VERSION=v26.0
# FAST2SMS_WHATSAPP_LANGUAGE=en

# Twilio Verify owns OTP generation and verification; no From number or Auth Token needed.
# SMS_PROVIDER=twilio-verify
TWILIO_VERIFY_ENABLED=0
TWILIO_VERIFY_LOCAL_DAILY_LIMIT=2
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET= (server only)
# TWILIO_VERIFY_SERVICE_SID=

# Direct Meta Cloud API: independent of SMS provider and Gmail sender.
# WHATSAPP_PROVIDER=meta
META_WHATSAPP_ENABLED=0
META_WHATSAPP_GRAPH_VERSION=v24.0
META_WHATSAPP_LOCAL_DAILY_LIMIT=10
# META_WHATSAPP_ACCESS_TOKEN= (server only)
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO=91... (allowed local test phone)
WHATSAPP_TEMPLATE_LANG=en
# META_WHATSAPP_BOOKING_TEMPLATE=carenest_appointment_update_v1
# META_WHATSAPP_REMINDER_TEMPLATE=carenest_appointment_reminder_v1
# META_WHATSAPP_TRANSACTION_TEMPLATE=carenest_transaction_receipt_v1
# META_WHATSAPP_UPDATE_TEMPLATE=carenest_account_update_v1
# Utility approval is checked at send time. hello_world is not a receipt template.
