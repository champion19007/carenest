# Copy to .env.local. Never commit real credentials.
# npm run dev/start forces loopback and embedded PostgreSQL; no cloud is used.
APP_ORIGIN=http://127.0.0.1:3000
SMS_PROVIDER=disabled
ALLOW_LOCAL_OTP=0
ENABLE_PAYMENTS=0
ENABLE_EXTERNAL_TRIAGE=0
ENABLE_SYMPTOM_ROUTING=0
TRUST_PROXY=0
# Independent local keys are generated in .data/secrets. Back them up with the DB.
# AUTH_SECRET= (minimum 32 characters; required for non-local operation)
# DATA_ENCRYPTION_KEY= (64 hex characters; required for non-local operation)
# npm run video:local generates private credentials and runs loopback-only LiveKit.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET= (minimum 32 characters; server only)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RAZORPAY_KEY_ID= (local mode accepts test keys only)
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CLAMSCAN_PATH= (absolute executable path; PDFs remain quarantined without it)
# RESEND_API_KEY=
# EMAIL_FROM=
# SMS live settings documented in lib/sms.ts; local worker never sends messages.
# Zoom API and SDK have been retired. Google Meet remains optional.
# Optional named-key envelope rotation. Keep the original storage key for v2 records/backups.
# DATA_ENCRYPTION_ACTIVE_ID=
# DATA_ENCRYPTION_KEYRING= (JSON map of key IDs to 64-character hex keys)
